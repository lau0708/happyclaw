# LLM 节点配置：复制本文件为 .env 并填入真实 key（.env 已被 gitignore，不会入库）
# 任何 OpenAI 兼容端点均可：DeepSeek / Kimi / GLM / Qwen 等
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 飞书自建应用（推荐）：卡片上的「接单 / 已处理 / 确认闭环」按钮只有走应用通道才能回传
# App ID / Secret 在开放平台「凭证与基础信息」拿；CHAT_ID 是目标群的 chat_id（oc_ 开头）
# 三件套配齐才启用；缺任意一个会退回下面的 webhook 文本推送（无按钮）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# 飞书群自定义机器人（群设置 → 群机器人 → 添加自定义机器人 → 拿到 Webhook 地址）
# 只能单向推送，收不到按钮回调；未配置应用通道时用它兜底
# 不填则跳过推送，不影响巡检运行
FEISHU_WEBHOOK_URL=
# 机器人安全设置选了「签名校验」时才需要填
FEISHU_WEBHOOK_SECRET=

# 设备指标上报鉴权（POST /api/metric）
# 不填：只接受本机上报（本地联调 / simulator 直连）
# 填了：网关等跨机上报必须带同名请求头 X-API-Key
INGEST_API_KEY=

# 经验回流：工单闭环时自动沉淀知识库（默认开）
# 置 0 关闭（比如演示时只想手动沉淀）
MES_AUTO_KNOWLEDGE=1
